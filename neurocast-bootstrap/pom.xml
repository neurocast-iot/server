<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.neurocast</groupId>
        <artifactId>neurocast-server</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>neurocast-bootstrap</artifactId>
    <name>neurocast-bootstrap</name>
    <description>装配启动模块：应用入口、环境配置、SQL 脚本，唯一可部署单元</description>

    <dependencies>
        <dependency>
            <groupId>com.neurocast</groupId>
            <artifactId>neurocast-system</artifactId>
        </dependency>
        <dependency>
            <groupId>com.neurocast</groupId>
            <artifactId>neurocast-device</artifactId>
        </dependency>
        <dependency>
            <groupId>com.neurocast</groupId>
            <artifactId>neurocast-media</artifactId>
        </dependency>
        <dependency>
            <groupId>com.neurocast</groupId>
            <artifactId>neurocast-member</artifactId>
        </dependency>
        <dependency>
            <groupId>com.neurocast</groupId>
            <artifactId>neurocast-job</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>neurocast-server</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
