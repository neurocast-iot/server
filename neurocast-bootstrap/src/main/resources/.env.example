# ==================== NeuroCast 环境配置示例 ====================
# 复制此文件为 .env 并填入实际值，供 docker-compose 等编排工具使用
# 也可直接修改 application-{profile}.yml 中对应的占位值

# ---------- 数据库 ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=neurocast
DB_USERNAME=thingsboard
DB_PASSWORD=your-db-password

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# ---------- JWT ----------
JWT_SECRET=your-jwt-secret-change-me

# ---------- ThingsBoard ----------
THINGSBOARD_URL=http://localhost:9090/
THINGSBOARD_USERNAME=tenant@thingsboard.org
THINGSBOARD_PASSWORD=your-thingsboard-password

# ---------- SRS 流媒体服务器 ----------
SRS_SERVER_IP=your-server-ip

# ---------- FTP 文件服务器 ----------
FTP_SERVER_IP=your-ftp-server-ip
FTP_USERNAME=camera_ftp
FTP_PASSWORD=your-ftp-password

# ---------- FRP 内网穿透 ----------
FRP_SERVER_IP=your-frp-server-ip
FRP_TOKEN=your-frp-token

# ---------- 域名 & API ----------
DOMAIN=your-domain.com
UPLOAD_API_KEY=your-upload-api-key
